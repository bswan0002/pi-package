{
  "name": "@bswan0002/pi-package",
  "version": "1.0.0",
  "description": "There are many pi packages, but this one is mine.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-theme"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@howaboua/pi-browser": "0.0.7",
    "@howaboua/pi-codex-conversion": "3.0.47",
    "@howaboua/pi-codex-imagegen": "0.0.10",
    "@howaboua/pi-codex-web-run": "0.0.7",
    "@shikijs/cli": "^4.0.2",
    "diff": "^9.0.0",
    "glob": "^13.0.6",
    "patch-package": "8.0.1",
    "shiki": "^4.0.2"
  }
}
