{
  "name": "@bswan0002/pi-package",
  "version": "1.0.0",
  "description": "There are many pi packages, but this one is mine.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-theme"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:quickjs": "node scripts/check-quickjs.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "typebox": "1.3.27"
  },
  "dependencies": {
    "@howaboua/pi-browser": "0.0.13",
    "@howaboua/pi-codex-conversion": "5.0.0",
    "@howaboua/pi-codex-imagegen": "0.0.14",
    "@howaboua/pi-codex-web-run": "0.0.10",
    "@shikijs/cli": "^4.0.2",
    "diff": "^9.0.0",
    "glob": "^13.0.6",
    "patch-package": "8.0.1",
    "shiki": "^4.0.2",
    "@howaboua/pi-notes-compaction": "0.0.17"
  }
}
