+import { open } from "node:fs/promises";
+import { constants } from "node:fs";
+
+// Display-only, bounded reads. Never let a preview change execution or failure semantics.
+const MAX_FILE_BYTES = 80_000;
+const MAX_TOTAL_BYTES = 1_000_000;
+export async function captureDisplayFiles(paths) {
+    const files = [];
+    let remaining = MAX_TOTAL_BYTES;
+    for (const path of paths) {
+        let handle;
+        try {
+            handle = await open(path, constants.O_RDONLY | constants.O_NONBLOCK);
+            const stat = await handle.stat();
+            if (!stat.isFile() || stat.size > Math.min(MAX_FILE_BYTES, remaining)) {
+                files.push({ path, unavailable: "Diff omitted: non-regular file or snapshot size limit" });
+                continue;
+            }
+            const buffer = Buffer.alloc(Math.min(MAX_FILE_BYTES, remaining) + 1);
+            let bytesRead = 0;
+            while (bytesRead < buffer.length) {
+                const chunk = await handle.read(buffer, bytesRead, buffer.length - bytesRead, bytesRead);
+                if (!chunk.bytesRead) break;
+                bytesRead += chunk.bytesRead;
+            }
+            remaining -= bytesRead;
+            const content = buffer.subarray(0, bytesRead).toString("utf8");
+            if (bytesRead > MAX_FILE_BYTES || remaining < 0 || content.includes("\0")) {
+                files.push({ path, unavailable: "Diff omitted: binary file or snapshot size limit" });
+            } else {
+                files.push({ path, content });
+            }
+        } catch (error) {
+            files.push(error?.code === "ENOENT" ? { path, content: null } : { path, unavailable: "Diff omitted: snapshot unreadable" });
+        } finally {
+            await handle?.close().catch(() => {});
+        }
+    }
+    return files;
+}
+
+export function pairDisplayFiles(before, after) {
+    return before.map((file, index) => ({
+        path: file.path,
+        ...(file.unavailable || after[index]?.unavailable
+            ? { unavailable: file.unavailable || after[index].unavailable }
+            : { before: file.content, after: after[index].content }),
+    }));
+}
