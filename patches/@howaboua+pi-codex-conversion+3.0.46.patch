+import { MouseRegion, truncateToWidth, visibleWidth } from "@earendil-works/pi-tui";
+
+const KEY = "codex-dictation-button";
+const labels = {
+    idle: "\uf130 Dictate",
+    connecting: "◌ Connecting…",
+    listening: "■ Stop · Listening",
+    transcribing: "◌ Transcribing…",
+    unavailable: "\uf130 Realtime active",
+};
+
+const realtimeLabels = {
+    idle: "\udb85\udc7d Voice chat",
+    connecting: "◌ Connecting chat…",
+    active: "■ Stop chat",
+    unavailable: "\udb85\udc7d Dictation active",
+};
+
+// One persistent widget; both modes share a transition guard and invalidation.
+export function registerDictationButton(pi, voice, toggle, toggleRealtime) {
+    let context;
+    let requestRender = () => {};
+    let pending;
+    const unsubscribe = voice.onDictationStateChange(() => requestRender());
+    const install = (_event, ctx) => {
+        context = ctx;
+        if (!ctx.hasUI) return;
+        ctx.ui.setWidget(KEY, (tui, theme) => {
+            requestRender = () => tui.requestRender();
+            let regions = [];
+            return new MouseRegion({
+                invalidate() {},
+                render(width) {
+                    const controls = [{ mode: "dictation", state: voice.dictationState, labels, action: toggle }];
+                    if (toggleRealtime) controls.push({ mode: "realtime", state: voice.realtimeState, labels: realtimeLabels, action: toggleRealtime });
+                    const buttons = controls.map(control => ({ ...control, text: ` ${pending?.mode === control.mode
+                        ? pending.stopping ? "◌ Stopping…" : control.labels.connecting
+                        : control.labels[control.state]} ` }));
+                    const total = buttons.reduce((size, button) => size + visibleWidth(button.text), buttons.length - 1);
+                    let offset = Math.max(0, width - total);
+                    let line = " ".repeat(offset);
+                    regions = [];
+                    for (const button of buttons) {
+                        const text = truncateToWidth(button.text, Math.max(0, width - offset), "");
+                        const right = offset + visibleWidth(text);
+                        regions.push({ ...button, left: offset, right });
+                        const color = pending ? "muted" : ["listening", "active"].includes(button.state) ? "success" : button.state === "idle" ? "accent" : "muted";
+                        line += theme.bg("toolPendingBg", theme.fg(color, text));
+                        offset = right;
+                        if (offset < width && button !== buttons.at(-1)) { line += " "; offset++; }
+                    }
+                    return [line];
+                },
+            }, (event) => {
+                if (event.type !== "click" || event.button !== "left" || event.y !== 0 ||
+                    event.shift || event.alt || event.ctrl) return;
+                const button = regions.find(region => event.x >= region.left && event.x < region.right);
+                if (!button) return;
+                const state = button.mode === "dictation" ? voice.dictationState : voice.realtimeState;
+                if (!pending && ["idle", "listening", "active"].includes(state)) {
+                    pending = { mode: button.mode, stopping: state !== "idle" };
+                    tui.requestRender();
+                    const current = context;
+                    void Promise.resolve().then(() => button.action(current)).catch((error) => {
+                        current.ui.notify(error instanceof Error ? error.message : String(error), "error");
+                    }).finally(() => {
+                        pending = undefined;
+                        requestRender();
+                    });
+                }
+                return { handled: true, render: true };
+            });
+        }, { placement: "aboveEditor" });
+    };
+    pi.on("session_start", install);
+    pi.on("session_switch", install);
