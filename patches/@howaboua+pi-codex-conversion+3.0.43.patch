@@ -0,0 +1,63 @@
+import { MouseRegion, truncateToWidth, visibleWidth } from "@earendil-works/pi-tui";
+
+const KEY = "codex-dictation-button";
+const labels = {
+    idle: "\uf130 Dictate",
+    connecting: "◌ Connecting…",
+    listening: "■ Stop · Listening",
+    transcribing: "◌ Transcribing…",
+    unavailable: "\uf130 Realtime active",
+};
+
+// One persistent widget; status updates request a render without replacing it.
+export function registerDictationButton(pi, voice, toggle) {
+    let context;
+    let requestRender = () => {};
+    let pending = false;
+    const unsubscribe = voice.onDictationStateChange(() => requestRender());
+    const install = (_event, ctx) => {
+        context = ctx;
+        if (!ctx.hasUI) return;
+        ctx.ui.setWidget(KEY, (tui, theme) => {
+            requestRender = () => tui.requestRender();
+            let left = 0;
+            let right = 0;
+            return new MouseRegion({
+                invalidate() {},
+                render(width) {
+                    const state = voice.dictationState;
+                    const label = pending && state === "idle" ? "◌ Connecting…" : labels[state];
+                    const button = truncateToWidth(` ${label} `, width, "");
+                    const size = visibleWidth(button);
+                    left = Math.max(0, width - size);
+                    right = left + size;
+                    const color = state === "listening" ? "success" : state === "idle" ? "accent" : "muted";
+                    return [" ".repeat(left) + theme.bg("toolPendingBg", theme.fg(color, button))];
+                },
+            }, (event) => {
+                if (event.type !== "click" || event.button !== "left" || event.y !== 0 ||
+                    event.x < left || event.x >= right || event.shift || event.alt || event.ctrl) return;
+                if (!pending && ["idle", "listening"].includes(voice.dictationState)) {
+                    pending = true;
+                    tui.requestRender();
+                    const current = context;
+                    void Promise.resolve().then(() => toggle(current)).catch((error) => {
+                        current.ui.notify(error instanceof Error ? error.message : String(error), "error");
+                    }).finally(() => {
+                        pending = false;
+                        requestRender();
+                    });
+                }
+                return { handled: true, render: true };
+            });
+        }, { placement: "aboveEditor" });
+    };
+    pi.on("session_start", install);
+    pi.on("session_switch", install);
+    pi.on("session_shutdown", () => {
+        unsubscribe();
+        context?.ui.setWidget(KEY, undefined);
+        context = undefined;
+        requestRender = () => {};
+    });
+}
